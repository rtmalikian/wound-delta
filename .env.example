# stub (default, no model) | local (Ollama/llama.cpp/vLLM on your own box)
# | upstream (any OpenAI-compatible provider)
AI_BACKEND=stub
LOCAL_MODEL_URL=http://localhost:11434
LOCAL_MODEL=llava:7b
UPSTREAM_BASE_URL=https://api.openai.com
UPSTREAM_API_KEY=
UPSTREAM_MODEL=gpt-4o-mini
# Default tier when a request does not name one: frugal | full
WOUND_DELTA_TIER=frugal
